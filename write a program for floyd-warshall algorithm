
# Floyd-Warshall Algorithm

INF = float('inf')

def floyd_warshall(graph):
    n = len(graph)

    # Create a copy of the graph
    dist = [row[:] for row in graph]

    # Find shortest paths
    for k in range(n):
        for i in range(n):
            for j in range(n):
                dist[i][j] = min(
                    dist[i][j],
                    dist[i][k] + dist[k][j]
                )

    return dist


# Example graph (INF means no direct edge)
graph = [
    [0,   5,   INF, 10],
    [INF, 0,   3,   INF],
    [INF, INF, 0,   1],
    [INF, INF, INF, 0]
]

result = floyd_warshall(graph)

# Print shortest distance matrix
print("Shortest distance matrix:")
for row in result:
    print(" ".join(
        "INF" if x == INF else str(int(x))
        for x in row
    ))
